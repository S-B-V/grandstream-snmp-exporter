        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "grandstream_host_resources_mib_hrsystemuptime{device_ip=\"$target\"}",
          "legendFormat": "{{device_ip}} {{hostname}} {{client_ip}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
