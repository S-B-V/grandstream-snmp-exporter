{
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    }
  ],
  "id": null,
  "uid": "grandstream-wifi-clients",
  "title": "Grandstream Wi-Fi Clients",
  "description": "Wireless clients across GWN7672 APs. Live state is sampled every 30 seconds; association/roaming history is inferred from samples.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "timezone": "browser",
  "tags": [
    "grandstream",
    "snmp",
    "wifi"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ap",
        "label": "Access point",
        "type": "query",
        "datasource": null,
        "definition": "label_values(grandstream_ap_client_info, device_ip)",
        "query": {
          "query": "label_values(grandstream_ap_client_info, device_ip)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      },
      {
        "name": "ssid",
        "label": "SSID",
        "type": "query",
        "datasource": null,
        "definition": "label_values(grandstream_ap_client_info, ssid)",
        "query": {
          "query": "label_values(grandstream_ap_client_info, ssid)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      },
      {
        "name": "client",
        "label": "Client MAC",
        "type": "query",
        "datasource": null,
        "definition": "label_values(grandstream_ap_client_info, client_mac)",
        "query": {
          "query": "label_values(grandstream_ap_client_info, client_mac)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Connected clients",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "count(grandstream_ap_client_info{device_ip=~\"$ap\",ssid=~\"$ssid\"})",
          "legendFormat": "{{device_ip}} {{hostname}} {{client_ip}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "description": "Clients visible during the latest Prometheus scrape."
    },
    {
      "id": 2,
      "title": "Active APs",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (device_ip) (grandstream_ap_client_info{device_ip=~\"$ap\",ssid=~\"$ssid\"}))",
          "legendFormat": "{{device_ip}} {{hostname}} {{client_ip}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "title": "Clients seen in 24h",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (client_mac) (max_over_time(grandstream_ap_client_info{device_ip=~\"$ap\",ssid=~\"$ssid\"}[24h])))",
          "legendFormat": "{{device_ip}} {{hostname}} {{client_ip}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "description": "Distinct MAC addresses seen over 24 hours; includes disconnected devices."
    },
    {
      "id": 4,
      "title": "Live wireless client inventory",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "grandstream_ap_client_info{device_ip=~\"$ap\",ssid=~\"$ssid\"}",
          "legendFormat": "{{device_ip}} {{hostname}} {{client_ip}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "IP",
            "desc": false
          }
        ]
      },
      "description": "Live records with device, IP, MAC, AP, BSSID and SSID. Empty hostnames are supplied by the AP. Use Grafana table filter/search.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "device_type": true
            },
            "indexByName": {
              "client_ip": 0,
              "hostname": 1,
              "device_ip": 2,
              "ssid": 3,
              "Value": 4,
              "client_mac": 5,
              "os": 6,
              "wlan_mac": 7,
              "service": 8,
              "pod": 9,
              "namespace": 10,
              "container": 11,
              "endpoint": 12
            },
            "renameByName": {
              "hostname": "Hostname",
              "client_ip": "IP",
              "client_mac": "MAC",
              "device_ip": "Access point",
              "ssid": "SSID",
              "wlan_mac": "BSSID",
              "os": "OS",
              "Value": "Connected",
              "service": "service",
              "pod": "pod",
              "namespace": "namespace",
              "container": "container",
              "endpoint": "endpoint"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Clients per AP",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "count by (device_ip) (grandstream_ap_client_info{device_ip=~\"$ap\",ssid=~\"$ssid\"})",
          "legendFormat": "{{device_ip}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Clients per SSID",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "count by (ssid) (grandstream_ap_client_info{device_ip=~\"$ap\",ssid=~\"$ssid\"})",
          "legendFormat": "{{ssid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Client signal (raw Grandstream value)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 9
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "grandstream_ap_client_signal{device_ip=~\"$ap\",ssid=~\"$ssid\",client_mac=~\"$client\"}",
          "legendFormat": "{{device_ip}} {{hostname}} {{client_ip}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Positive values seen in the SNMP walk; do not interpret as dBm until Grandstream scaling is confirmed."
    },
    {
      "id": 8,
      "title": "Client association duration",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 9
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "grandstream_ap_client_association_seconds{device_ip=~\"$ap\",ssid=~\"$ssid\",client_mac=~\"$client\"}",
          "legendFormat": "{{device_ip}} {{hostname}} {{client_ip}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Client / AP association history",
      "type": "state-timeline",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 9
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "grandstream_ap_client_info{device_ip=~\"$ap\",ssid=~\"$ssid\",client_mac=~\"$client\"}",
          "legendFormat": "{{device_ip}} {{hostname}} {{client_ip}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "A series exists while a client is associated. Inspect client MAC and AP in legend; intervals between scrapes and short roams can be missed."
    },
    {
      "id": 10,
      "title": "Last observed samples by AP (24h)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 9
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time(grandstream_ap_client_info{device_ip=~\"$ap\",ssid=~\"$ssid\"}[24h])",
          "legendFormat": "{{device_ip}} {{hostname}} {{client_ip}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Hostname",
            "desc": false
          }
        ]
      },
      "description": "Clients seen within the past 24 hours, not necessarily currently online. Inventory labels reflect the recorded series; DHCP/hostname changes may produce multiple rows.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "device_type": true
            },
            "indexByName": {},
            "renameByName": {
              "hostname": "Hostname",
              "client_ip": "IP address",
              "client_mac": "MAC address",
              "device_ip": "Access point",
              "ssid": "SSID",
              "wlan_mac": "BSSID",
              "os": "OS",
              "Value": "Connected"
            }
          }
